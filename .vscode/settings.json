{
  // ? ".vscode/settings.json"
  // * These settings should be backed up from vscode's user sync.
  
  /* // {} Vscode Editor Settings and custom theme preferences.
    The configurations listed below are a mix of performance, display optimizations that vscode provides by default,
    and custom styling to make vscode feel more streamline while using this for developing full stack applications.
    
    I've grown accustomed to the "Night Owl" dark theme, but then recently started using Rider for projects
    for different applications, and it's definitely helped with those tasks.

    Here's a comprehensive list of the things it adds, and what plugins they use for each one:
      ? gpu acceleration for terminal specific tasks, windows shell integration, automated tasks, custom tab name definitions
      ? adds smooth(interpolated) scrolling in general (files, sidebar, and padding when scrolling (arrow keys) to see the current code)
      ? adds the setting for sticky scrolling. Attaches the function def hierarchy you're navigating through currently
      ? outline and breadcrumbs QoL settings (collapsed list, position category)
      
      ? enhanced visuals and additions for themes:
        * plugin: better-comments
          - Let's you add custom colored tags when coding. Can help distinguish code blocks for sensemaking
        * workbench.colorCustomizations
          - Additional edits to the global, or specific theme. We use for parts of the rider theme it doesn't account for, like peek definitions.
        * plugin: Custom UI Styles
          - Let's you edit vscode's styles directly. We added styles to make the editor have more of a pop to it.
            - box shadows on tooltips, hover elements, around the displayed file, and peek definition windows.
              - The shadows help with readability, but in different light modes you might need to adjust them
            - Made the peek definition window be it's own hover element, so it's not stuck to the sides of the file
              - Kind of helps with reading where you are in the file without it seamlessly blending, reminds me of Rider.
            
      ? plugins I'd forget
        * Prettier, Code-Indent Rainbow, Color Highlight, Material Icon theme, Image preview 
        * Tailwind css intellisense, tailwind fold, 
        * bookmarks, better-comments, jSDocMarkdown plus, custom ui style
  */
  
  
  
  
  
  
  
  
  // #region QoL settings
  /** 
   * ? Vscode Editor's QoL settings
   * Includes a variety of stuff
   */
  // --- VsCode Sidebar --- //
  "workbench.activityBar.location": "top", // sidebar tab icons
  "workbench.activityBar.compact": false,
  "workbench.editor.pinnedTabsOnSeparateRow": true, // second tab row
  "workbench.list.smoothScrolling": true,
  // "workbench.editor.wrapTabs": true, // messy
  // "workbench.editor.tabSizing": "fit",
  
  // --- Visuals --- //
  "editor.cursorBlinking": "smooth", // smooth fading
  "editor.smoothScrolling": true, // animated scrolling
  "editor.cursorSurroundingLines": 8, // arrow keys near the bottom will traverse
  "editor.mouseWheelScrollSensitivity": 1.5,
  "editor.linkedEditing": true, // edits the opening/closing tabs at the same time
  
  // --- Smart Tab Naming for Monorepos --- //
  "workbench.editor.customLabels.patterns": {
    "**/apps/**/index.*": "${dirname}/index.${ext}",
    "**/libs/**/index.*": "${dirname}/index.${ext}",
    
  },
  
  // --- Sticky Scroll --- //
  "editor.stickyScroll.enabled": true, // function hierarchy navLink below the breadcrumbs
  "editor.stickyScroll.maxLineCount": 8, // max nested scope lines(5).
  
  // --- Breadcrumbs and outlines --- //
  "outline.collapseItems": "alwaysCollapse", // for readability
  "breadcrumbs.enabled": true, // Enables folder/function navigation below the file tabs
  "breadcrumbs.symbolSortOrder": "position",
  
  
  
  
  // #endregion
  // #region Terminal settings
  /** 
   * ? Vscode's Terminal's configuration
   * Primarily adjusting the font, as well as some other settings
   */
  // --- General --- //
  "terminal.integrated.shellIntegration.showCommandGuide": true,
  "terminal.integrated.rightClickBehavior": "copyPaste",
  "task.allowAutomaticTasks": "on",
  
  // --- Smooth Rendering & Cursor Control --- //
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.mouseWheelScrollSensitivity": 1.5,
  
  // --- Utils --- //
  // "terminal.integrated.persistentSessionReviveProcess": "never",
  
  // --- Important --- //
  "terminal.integrated.gpuAcceleration": "on",
  "terminal.integrated.shellIntegration.enabled": true,
  
  // --- Terminal Font Styling --- //
  "terminal.integrated.fontFamily": "'JetBrains Mono', 'Fira Code', monospace",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.fontWeight": "normal",
  "terminal.integrated.letterSpacing": 0.5,
  "terminal.integrated.lineHeight": 1.2,
  
  // --- Tab layout --- //
  "terminal.integrated.tabs.enabled": true,
  "terminal.integrated.tabs.location": "left",
  "terminal.integrated.tabs.title": "${process}",
  // "terminal.integrated.tabs.separator": " :test: ", // Isn't working 
  "terminal.integrated.tabs.description": "${process}",
  
  
  
  
  // #endregion
  // #region Theme customizations
  /** 
   * -> Additional theme customizations
   * {} Editor Customizations - Adjusted Rider Theme to add stuff that hasn't been implemented
   * * Token Color Customizations - Adjusted the themeing to make Typescript better color coded
   * * Custom UI Styles - Better readability and streamlined look of VSCode's File view
   * * JSDoc (function, var, etc.) popup hover custom theme styles 
   * * Tagged Comment Themes - Helpful colorized notes while traversing code.
   */
  // #region Editor Customizations
  "workbench.colorCustomizations": {
    //------------------------------------//
    // * Global Settings                  //
    // -> vscode disables these elswhere  //
    //------------------------------------//
    // ? --- Night Owl Theme --- //
    // "textCodeBlock.background": "#282c34", 
    
    // ? --- Rider theme --- //
    "textCodeBlock.background": "#1b8a65",
    
    
    
    
    //------------------------------------//
    // Night Owl Theme                    //
    //------------------------------------//
    // "[Night Owl Theme]": {
    //   // ? JSDoc Function Tooltip
    //   "editorHoverWidget.background": "#1e222a",
    //   "editorHoverWidget.border": "#4286f4b0",
    //   "editorHoverWidget.statusBarBackground": "#21252b"
    //   // "textBlockCodeBlock.background": "#282c34",
    // },
    
    
    //------------------------------------//
    // Rider Dark Theme                   //
    //------------------------------------//
    "[JetBrains Rider Dark Theme]": {
      // ? JSDoc Function Tooltip
      // "editorHoverWidget.background": "#202020",
      // "editorHoverWidget.border": "#236327",
      // "editorHoverWidget.statusBarBackground": "#313335",
      
      // ? JSDoc Function Tooltip
      "editorHoverWidget.background": "#2a2c30",    // Slightly lighter than the editor to make it stand out naturally
      "editorHoverWidget.border": "#2e7d32",        // a darker emerald green contrast frame
      "editorHoverWidget.statusBarBackground": "#222325",
      // "textBlockCodeBlock.background": "#1b8a65",
      
      // ? Theme adjustments
      "editor.background": "#242527", // adjusted background (darkened)
      "editor.lineHighlightBackground": "#2a2b2e", // selected line
      
      // ? Surrounding Layout Elements 
      "sideBar.background": "#28292c", // sidebar
      "activityBar.background": "#1a1b1e", // Icon bar
      "statusBar.background": "#28292b", // bottom bar
      
      // ? Bottom Panel (Terminal/Console) styls
      "panel.background": "#222327", // Darkened base background panel container
      "panel.border": "#14913a1f", // Separator outline border directly below code canvas, and content/sidebar border
      "panelTitle.border": "#14913a6e", // The panel's bottom border
      "panelTitle.activeForeground": "#30da93e7", // Active title color
      // "panelTitle.activeBorder": "#199e41e3", // Bottom border (selected tab)
      "panelTitle.inactiveForeground": "#607a86", // Muted title label text
      "panelStickyScroll.background": "#1e1f22",
      
      // ? Top bar function title
      "editorStickyScroll.background": "#1d241f9d", 
      "editorStickyScrollHover.background": "#1d4729", 
      
      // ? Tabs & Navigation 
      "tab.activeBackground": "#13352b", 
      "tab.inactiveBackground": "#1c1d20", 
      "editorGroupHeader.tabsBackground": "#1a1b1e", 
      "editorGroupHeader.border": "#2e7d3255", // breadcrumbs border
      // "editorGroupHeader.tabsBorder": "#32343a", // default
      
      // * By default, Rider Dark Theme doesn't include peek definition styles.
      // --- Peek Definition Styles --- //
      // ? The header row containing the file name
      "peekViewTitle.background": "#212327",
      "peekViewTitleLabel.foreground": "#30da93ea", 
      "peekViewTitleDescription.foreground": "#69818b",
      
      // ? The left (primary) container showing the actual code snippet
      "peekViewEditor.background": "#1d1e20",
      "peekViewEditor.matchHighlightBackground": "#2d6b3055",
      
      // ? The right (file refs list) container showing the results list panel
      "peekViewResult.background": "#232427", 
      "peekViewResult.lineForeground": "#858585", 
      "peekViewResult.fileForeground": "#a6b8c0", 
      "peekViewResult.selectionBackground": "#1a5ec562", // Color when you highlight a file in the list
      "peekViewResult.selectionForeground": "#ffffff", 
      "peekViewResult.matchHighlightBackground": "#146e2b5e", 
      
      // ? The border dividing lines around the peek window wrapper
      "peekView.border": "#2e7d32" // Hard green accent outline to match the hover border
    },
    
    
  },
  // #endregion
  // #region Token Color Customizations (vars, tags, etc.)
  "editor.tokenColorCustomizations": {
    //------------------------------------//
    // Rider Dark Theme                   //
    //------------------------------------//
    "[JetBrains Rider Dark Theme]": {
      "textMateRules": [
        // #region HTML Custom Styles
        {
          "name": "Target only HTML JSX properties/attributes",
          "scope": [
            "entity.other.attribute-name.html",
            "entity.other.attribute-name.js",
            "entity.other.attribute-name.jsx",
            "entity.other.attribute-name.tsx",
            "meta.tag.attributes.js",
            "meta.tag.attributes.jsx",
            "meta.tag.attributes.tsx"
          ],
          "settings": {
            "foreground": "#7190eb" 
          }
        },
        {
          "name": "Variables passed as JSX property values",
          "scope": [
            "meta.tag.attributes variable.other.readwrite",
            "meta.tag.attributes variable.other.object",
            "meta.tag.attributes variable",
            "meta.attribute variable"
          ],
          "settings": {
            "foreground": "#4dbcc4"
          }
        },
        
        
        
        
        // #endregion
        // #region CSS Custom Styles
        {
          "name": "Target HTML Tags/Elements in SCSS",
          "scope": [
            "entity.name.tag.scss",
            "entity.name.tag.css"
          ],
          "settings": {
            "foreground": "#77d6c2" 
          }
        },
        {
          "name": "Universal Class Declarations",
          "scope": [
            "entity.other.attribute-name.class"
          ],
          "settings": {
            "foreground": "#a9d8db" 
          }
        },
        {
          "name": "Robust @apply Class Override (SCSS + CSS)",
          "scope": [
            // Forces classes inside an active @apply wrapper
            "meta.at-rule.apply entity.other.attribute-name.class",
            "meta.at-rule.apply.scss entity.other.attribute-name.class",
            "meta.at-rule.apply.css entity.other.attribute-name.class",
            "source.css.scss meta.at-rule.apply variable.scss",
            "source.scss meta.at-rule.apply variable.scss"
          ],
          "settings": {
            "foreground": "#2fc6e2"
          }
        },
        {
          "name": "Universal Tailwind @apply directive token",
          "scope": [
            "keyword.control.at-rule"
          ],
          "settings": {
            "foreground": "#4d85fd" 
          }
        },
        {
          "name": "Universal Parent Nesting Symbol (&)",
          "scope": [
            "keyword.operator.combinator",
            "keyword.operator.parent-selector",
            "variable.language.this",
            "entity.name.tag.reference"
          ],
          "settings": {
            "foreground": "#50a5ff" 
          }
        },
        {
          "name": "Universal State Modifiers (:hover, :focus, etc.)",
          "scope": [
            "entity.other.attribute-name.pseudo-class",
            "entity.other.attribute-name.pseudo-element",
            "entity.other.attribute-name.tag.pseudo-class"
          ],
          "settings": {
            "foreground": "#b19bce" 
          }
        },
        
        
        
        
        // #endregion
        // #region Comments Custom Styles
        {
          "name": "Standard JavaScript Comments (Single and Block)",
          "scope": [
              "comment.line.double-slash.js",
              "comment.line.double-slash.jsx",
              "comment.line.double-slash.ts",
              "comment.line.double-slash.tsx",
              "comment.block.js",
              "comment.block.jsx",
              "comment.block.ts",
              "comment.block.tsx"
          ],
          "settings": {
            "foreground": "#7f8d9e",
            "fontStyle": "italic"
          }
        },
        {
          "name": "Comments wrapped inside JSX HTML tags",
          "scope": [
            "meta.tag comment.line.double-slash",
            "meta.tag punctuation.definition.comment",
            "meta.tag.attributes comment.line.double-slash",
            "meta.jsx.children comment.block.js",
            "meta.jsx.children comment.block.jsx",
            "meta.jsx.children comment.block.ts",
            "meta.jsx.children comment.block.tsx",
            "meta.jsx.children punctuation.definition.comment",
            "meta.jsx.children punctuation.definition.bracket.curly"
          ],
          "settings": {
            "foreground": "#727684",
            "fontStyle": "italic"
          }
        },
        {
          "name": "Strings (Single/Double quotes)",
          "scope": [
            "string.quoted.double.html",
            "string.quoted.single.html",
            "string.quoted.double.js",
            "string.quoted.single.js",
            "string.quoted.double.jsx",
            "string.quoted.single.jsx",
            "string.quoted.double.tsx",
            "string.quoted.single.tsx",
            "meta.embedded.expression.string"
          ],
          "settings": {
            "foreground": "#34b966" 
          }
        },
        {
          "name": "String Interpolation / Template Literals Text & Backticks",
          "scope": [
            "string.template",
            "string.quoted.template",
            "punctuation.definition.string.template"
          ],
          "settings": {
            "foreground": "#34b966"
          }
        },
        {
          "name": "String Interpolation Brackets Only",
          "scope": [
            "punctuation.definition.template-expression.begin",
            "punctuation.definition.template-expression.end"
          ],
          "settings": {
            "foreground": "#c664fc"
          }
        },
        {
          "name": "String Interpolation Variables and Expressions",
          "scope": [
            "string.template variable",
            "string.template variable.other",
            "string.template variable.other.readwrite",
            "string.template variable.other.property",
            "string.template variable.other.object",
            "string.quoted.template variable",
            "meta.template.expression.js variable",
            "meta.template.expression.ts variable",
            "meta.template.expression.js variable.other.readwrite.js",
            "meta.template.expression.ts variable.other.readwrite.ts"
          ],
          "settings": {
            "foreground": "#b856ec",
            "fontStyle": "italic"
          }
        }
        
        
        
        
        // #endregion
      ]
    }
  },
  // #endregion
  // #region Custom UI Styles (Makes VSCode look a lot more streamline)
  /**
   * -> "Custom UI Styles" Extension
   * * Lets you add custom styles to VSCode's actual elements.
   * * Makes VSCode look a lot more streamline, and improces readability a lot while navigating
   * ? To reload updated styles: "Ctrl + Shift + P" -> "Custom UI Style: Reload"
   */
  "custom-ui-style.stylesheet": {
    //----------------------------------//
    // JsDoc definition hover tooltip   // 
    //----------------------------------//
    // Targets the core text box layout of the hover widget
    ".monaco-editor .hover-contents": {
      "padding": "12px 16px 12px 12px !important", // By default, "Rider Dark Theme has a lot of top padding here?
      "scroll-behavior": "smooth !important",
      
      // Remove the extra padding from the headers
      "h1:first-child, h2:first-child, h3:first-child": {
        "margin-top": "2px !important",
        "margin-bottom": "4px !important",
        "display": "inline-flex !important",
        "align-items": "center !important",
        // "border": "1px solid #ffffff !important",
        // "color": "#2b1fc3"
      },
    },
    
    // Add a border after the definition (title) 
    ".markdown-hover:first-child:not(:only-child)": {
      "border-bottom": "1px solid #3c3f41 !important",
      "display": "block !important",
    },
    
    // Targets structural rows inside the tooltip window
    // ".monaco-hover .hover-row": {
    //   "padding": "4px 12px !important"
    // },
    
    
    // -----------------------------------//
    // JsDoc Tooltip styles               //
    // -----------------------------------//
    ".monaco-editor .monaco-hover": { // add a box shadow to the tooltip
      "box-shadow": "0 0 32px -6px rgba(0, 0, 0, 0.60) !important",
      "backdrop-filter": "blur(4px) !important", 
    },
    
    
    // -----------------------------------//
    // Peek definition styles             //
    // -----------------------------------//
    ".monaco-editor .peekview-widget": {
      "box-shadow": "0 0 32px -6px rgba(0, 0, 0, 0.64) !important",
      "backdrop-filter": "blur(4px) !important", 
      
      // * Give it the look of a popup in the code view
      "margin-left": "32px !important", // begins at the lines element
      "margin-right": "16px !important", // ends before the code minimap or file container
      "border-left": "1px solid #2e7d32", // add the side borders
      "border-right": "1px solid #2e7d32", 
      "border-radius": "8px !important", 
    },
    
    
    // -----------------------------------//
    // Bottom Panel Styling               //
    // -----------------------------------//
    // Panel tabs (console, terminal) background
    ".monaco-workbench .part.panel .action-item, .monaco-workbench .part.panel .action-label, .monaco-workbench .part.panel .monaco-action-bar, .monaco-workbench .part.panel .composite.header, .monaco-workbench .part.panel .composite.title, .monaco-workbench .part.panel .title-label": {
      "background-color": "#27282c !important",
      "border": "none !important"
    },
    
    
    // -----------------------------------//
    // File's box shadow(s)               //
    // -----------------------------------//
    // <- @note VSCode Edits to the index for this might cause trouble -> ref - TODO: hidden items in file view?
    // Add a shadow to the file view to add some visual distinction between the console
    ".monaco-editor .overflow-guard::after": {
      "box-shadow": "inset 0 24px 14px -12px rgba(0, 0, 0, 0.30), inset 0 -24px 14px -12px rgba(0, 0, 0, 0.15) !important", // inset shadow (top / bottom)
      "pointer-events": "none !important", // let us still click and highlight your code through the shadow layer
      "z-index": "10 !important",
      "content": "'' !important",
      "position": "absolute !important",
      "top": "0 !important",
      "left": "0 !important",
      "width": "100% !important",
      "height": "100% !important",
    },
    
    // * Sticky container/widget: the current function hierarchical display at the top of the file, below the file tabs and breadcrumbs.
    // The Sticky scroll widget. The root and all nested functions and other definitions that are displayed
    ".monaco-editor .sticky-widget": {
      "border-bottom": "1px solid #2e7d3255 !important", // sticky scroll (and root) bottom border
      "box-shadow": "0 16px 14px -4px rgba(0, 0, 0, 0.20) !important", // same as the file's inset shadow
      "overflow": "visible !important",
      "z-index": "12 !important", // Keep this in front of the file's inset shadow 
      // "position": "relative !important",
      // "width": "100% !important"
    },
    
    // Add a shadow to the left of the minimap (scroll code map)
    ".monaco-editor .minimap": {
      "box-shadow": "-12px 0px 20px -4px rgba(0, 0, 0, 0.20) !important", // left shadow
    },
    
    
    // -----------------------------------//
    // Explorer Stacked Shadow (FileList) //
    // -----------------------------------//
    // Targets the last pinned folder element at the bottom of the sticky header stack
    // ".explorer-folders-view .monaco-tree-sticky-container .monaco-tree-sticky-row:last-child .monaco-tl-row": {
    ".explorer-folders-view .monaco-tree-sticky-container": {
      "box-shadow": "0 16px 20px -4px rgba(0, 0, 0, 0.15) !important",
      "backdrop-filter": "blur(4px) !important", 
      "border-bottom": "1px solid #3f4542 !important",
      // "border-bottom": "1px solid #3c3f40 !important",
      // "border-bottom": "1px solid #2e7d3255 !important",
    }
    
    
  },
  "custom-ui-style.agents.stylesheet": {
  },
  
  
  
  
  // #endregion
  // #region Tagged Comment Themes
  /** 
   * Tagged comment themes
   */
  "better-comments.multilineComments": true,
  "better-comments.highlightPlainText": true,
  "better-comments.tags": [
    // ! This comment's color is red -> error/fallback?
    // * This comment's current color is turquoise    -> notes?
    // ? This comment's current color is blue         -> condition/scenario?
    // () This comment's current color is blue        -> pseudo function notes?
    // {} This comment's current color is blue        -> code block notes?
    // -> This comment's color is green               -> return scenario?
    // <- This comment's color is purple              -> misc comment - return scenarios.
    // TODO: This comment's color is orange           -> todo comment.
    // #region This comment's color is gray           -> region comment.
    {
      "tag": "!", "color": "#fa3d3e", 
      "backgroundColor": "#00000033",
      "strikethrough": false, "underline": false,
      "bold": false, "italic": true,
      "exact": true
    },
    {
      // "tag": "?", "color": "#7499ff", // default
      "tag": "?", "color": "#30da93", // Rider turqoise
      "backgroundColor": "#00000033",
      "strikethrough": false, "underline": false, 
      "bold": false, "italic": true
    },
    {
      "tag": "()", "color": "#7499ff", "backgroundColor": "#00000033",
      "strikethrough": false, "underline": false,  "bold": false, "italic": true
    },
    {
      "tag": "{}", "color": "#7499ff", "backgroundColor": "#00000033",
      "strikethrough": false, "underline": false,  "bold": false, "italic": true
    },
    {
      "tag": "*", "color": "#4bbcdc",
      "backgroundColor": "#00000033",
      "strikethrough": false, "underline": false, 
      "bold": false, "italic": true
    },
    {
      "tag": "->", "color": "#12b362",
      "backgroundColor": "#00000033",
      "strikethrough": false, "underline": false, 
      "bold": false, "italic": true
    },    
    {
      "tag": "<-", "color": "#a94ada", 
      "backgroundColor": "#00000033",
      "strikethrough": false, "underline": false,
      "bold": false, "italic": true
    },
    {
      "tag": "todo", "color": "#FF8C00", 
      "backgroundColor": "#00000033",
      "strikethrough": false, "underline": false,
      "bold": false, "italic": true
    },
    {
      "tag": "#region", "color": "#608291", 
      "backgroundColor": "#00000033",
      "strikethrough": false, "underline": false,
      "bold": false, "italic": true
    },
    {
      "tag": "#endregion", "color": "#608291", 
      "backgroundColor": "#00000033",
      "strikethrough": false, "underline": false,
      "bold": false, "italic": true
    },
  ],
  
  
  
  // #endregion
  
  
  
  
  // #endregion
  
  
  //----------------------------------------------------------------//
  // Edited from the settings menu                                  //
  //----------------------------------------------------------------//
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "editor.fontLigatures": true,
  "editor.fontFamily": "'JetBrains Mono',  'Fira Code', Consolas, 'Courier New', monospace",
  "editor.codeLensFontFamily": "Fira Code Retina",
  "terminal.integrated.scrollback": 34000,
  "explorer.confirmDelete": false,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "explorer.confirmDragAndDrop": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.tabSize": 2,
  "editor.codeActionsOnSave": {},
  "editor.formatOnSaveMode": "modifications",
  "nxConsole.showNodeVersionOnStartup": false,
  "redhat.telemetry.enabled": true,
  "cSpell.userWords": [
    "checkmark",
    "devlogs",
    "inbetween",
    "interp",
    "lerp",
    "oultine",
    "Signup",
    "tailwindcss",
    "tailwindplus",
    "todos",
    "uuidv",
    "zipcode"
  ],
  "git.openRepositoryInParentFolders": "always",
  "totalTypeScript.hiddenTips": [
    "typing-function-parameters",
    "ts-object-type",
    "optional-object-property",
    "basic-types",
    "literal-type",
    "union-type",
    "variable-type-annotation",
    "null-keyword",
